# Copy to .env.local for local development, or set in your host's dashboard.

# Optional: enables OpenAI-backed AI Planner answers. Without it the planner
# returns its built-in rule-based answers. Server-side only; never exposed.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional: point at a different Supabase project. Defaults to the production
# project (the anon key is public by design; row-level security protects data).
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
